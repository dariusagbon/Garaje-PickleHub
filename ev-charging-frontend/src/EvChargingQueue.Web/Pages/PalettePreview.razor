@page "/palette"
@inject Palette Palette

<PageTitle>Palette · EV Charging Queue</PageTitle>

<h1>Palette</h1>

<section class="scale">
    <h2>Palette roles</h2>
    <div class="swatches">
        @foreach (var (name, hex) in Palette.Roles)
        {
            <Swatch Color="ThemeColor.FromHex(hex)" Label="@name" />
        }
    </div>
</section>

<ColorGroup Title="Tints" MixedWith="white" Colors="Palette.Tints.All" />
<ColorGroup Title="Tones" MixedWith="gray" Colors="Palette.Tones.All" />
<ColorGroup Title="Shades" MixedWith="black" Colors="Palette.Shades.All" />
