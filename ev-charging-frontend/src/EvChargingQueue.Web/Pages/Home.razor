@page "/"

<PageTitle>Queue · EV Charging Queue</PageTitle>

<h1>Charging queue</h1>

<p>Station status colors come from the palette (<code>--color-available-*</code>, <code>--color-charging-*</code>, …).</p>

<div class="stations">
    <div class="station station--available">Charger A · Available</div>
    <div class="station station--charging">Charger B · Charging</div>
    <div class="station station--waiting">Charger C · Reserved</div>
    <div class="station station--fault">Charger D · Out of service</div>
</div>

<button class="btn-primary">Join queue</button>
